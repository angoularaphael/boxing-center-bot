# Campagne — 12 messages / 30 min, ~2m30 entre chaque envoi
WA_BULK_WINDOW_MS=1800000
WA_BULK_MAX_PER_WINDOW=12
WA_BULK_DELAY_MS=150000
WA_BULK_DELAY_JITTER_MS=30000

