# Vercel gestion-manager :
#   NEXT_PUBLIC_WHATSAPP_BOT_URL=http://prem-eu4.bot-hosting.net:21357

# ── Serveur hub ───────────────────────────────────────────────────────────────
SERVER_PORT=21357
PORT=21357
